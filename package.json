{
  "name": "smart-college-events",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "emulator:start": "$ANDROID_HOME/emulator/emulator -avd Pixel_7 -no-audio -no-boot-anim &",
    "appium:start": "appium --base-path /",
    "appium:test": "wdio run automation/appium/config/wdio.conf.ts",
    "android:test": "npm run emulator:start && sleep 10 && $ANDROID_HOME/platform-tools/adb reverse tcp:8081 tcp:8081 && $ANDROID_HOME/platform-tools/adb reverse tcp:5005 tcp:5005 && npm run appium:test",
    "reports": "npx ts-node automation/appium/utils/generateTestCaseMaster.ts && npx ts-node automation/appium/utils/generateReports.ts",
    "selenium:test": "mkdir -p automation/selenium/reports && npx mocha -r ts-node/register automation/selenium/tests/smoke.web.test.ts --reporter json > automation/selenium/reports/results.json",
    "selenium:reports": "npx ts-node automation/selenium/utils/generateSeleniumTestCaseMaster.ts && npx ts-node automation/selenium/utils/generateSeleniumReports.ts",
    "security:reports": "npx ts-node automation/selenium/utils/generateSecurityArtifacts.ts",
    "load:baseline": "k6 run automation/load/baseline.js",
    "load:stress": "k6 run automation/load/stress.js",
    "load:spike": "k6 run automation/load/spike.js",
    "load:endurance": "k6 run automation/load/endurance.js",
    "load:reports": "npx ts-node automation/load/utils/generateLoadReports.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.0",
    "expo-barcode-scanner": "~13.0.1",
    "expo-blur": "~13.0.2",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "install": "^0.13.0",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "^0.19.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "~18.2.79",
    "@types/selenium-webdriver": "^4.35.6",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/cli": "^8.27.0",
    "@wdio/json-reporter": "^8.27.0",
    "@wdio/local-runner": "^8.27.0",
    "@wdio/mocha-framework": "^8.27.0",
    "@wdio/spec-reporter": "^8.27.0",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.2.2",
    "chai": "^4.3.10",
    "exceljs": "^4.4.0",
    "selenium-webdriver": "^4.46.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "wdio-appium-service": "^0.2.3"
  }
}
