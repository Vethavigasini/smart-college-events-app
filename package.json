{
  "name": "smart-college-events",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "emulator:start": "$ANDROID_HOME/emulator/emulator -avd Pixel_7 -no-audio -no-boot-anim &",
    "appium:start": "appium --base-path /",
    "appium:test": "wdio run automation/appium/config/wdio.conf.ts",
    "android:test": "npm run emulator:start && sleep 10 && $ANDROID_HOME/platform-tools/adb reverse tcp:8081 tcp:8081 && $ANDROID_HOME/platform-tools/adb reverse tcp:5005 tcp:5005 && npm run appium:test",
    "reports": "npx ts-node automation/appium/utils/generateTestCaseMaster.ts && npx ts-node automation/appium/utils/generateReports.ts",
    "selenium:test": "mkdir -p automation/selenium/reports automation/selenium/logs && TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx mocha -r ts-node/register automation/selenium/tests/smoke.web.test.ts --reporter json > automation/selenium/reports/results.json 2> automation/selenium/logs/selenium-run.log",
    "selenium:reports": "TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx ts-node automation/selenium/utils/generateSeleniumTestCaseMaster.ts && TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx ts-node automation/selenium/utils/generateSeleniumReports.ts",
    "security:reports": "TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx ts-node automation/selenium/utils/generateSecurityArtifacts.ts",
    "security:test": "mkdir -p automation/security/reports && TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx mocha -r ts-node/register automation/security/tests/security.test.ts",
    "load:baseline": "k6 run automation/load/baseline.js",
    "load:stress": "k6 run automation/load/stress.js",
    "load:spike": "k6 run automation/load/spike.js",
    "load:endurance": "k6 run automation/load/endurance.js",
    "load:reports": "TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx ts-node automation/load/utils/generateLoadReports.ts",
    "reports:master": "TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx ts-node automation/shared/utils/generateMasterDashboard.ts",
    "api:test": "mkdir -p automation/api/reports && TS_NODE_PROJECT=\"automation/tsconfig.automation.json\" npx mocha -r ts-node/register automation/api/tests/api.test.ts --reporter json > automation/api/reports/results.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.0",
    "expo-barcode-scanner": "~13.0.1",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "install": "^0.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-qrcode-svg": "^6.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "~0.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli-tools": "^15.0.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/react": "~19.1.0",
    "@types/selenium-webdriver": "^4.35.6",
    "@wdio/appium-service": "^9.30.1",
    "@wdio/cli": "^8.27.0",
    "@wdio/json-reporter": "^8.27.0",
    "@wdio/local-runner": "^8.27.0",
    "@wdio/mocha-framework": "^8.27.0",
    "@wdio/spec-reporter": "^8.27.0",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.2.2",
    "babel-preset-expo": "^54.0.0",
    "chai": "^4.3.10",
    "exceljs": "^4.4.0",
    "gh-pages": "^6.3.0",
    "selenium-webdriver": "^4.46.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "wdio-appium-service": "^0.2.3"
  }
}
